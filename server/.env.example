# Port the API listens on
PORT=4000

# Frontend origin allowed to call this API (Vite dev server)
ALLOWED_ORIGIN=http://localhost:5173

# Backoffice login (e-mail + password). Don't edit these by hand — run:
#   npm run set-admin -- <email> <password>
# It stores a hash of the password (never the password itself) and
# generates SESSION_SECRET, the key that signs login sessions.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# --- Email notifications for new contact messages (optional) ---
# Leave these empty to skip email sending — messages are still saved.
# Example for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_USER=you@gmail.com, SMTP_PASS=<app password>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=contact@eraydigital.tech
